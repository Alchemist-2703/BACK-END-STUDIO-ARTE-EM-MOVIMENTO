# ==============================================================================
# CONFIGURAÇÕES DO SISTEMA - STUDIO ARTE EM MOVIMENTO
# Copie este arquivo para .env e preencha com suas credenciais reais
# ==============================================================================

PROJECT_NAME="Studio Arte em Movimento - API Financeira"
ENVIRONMENT="development"

# Chave de API do Google Gemini (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Conexão com o Supabase (Painel Supabase > Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co
# Recomendado usar a 'service_role' para o backend poder ler/escrever sem restrição de RLS
SUPABASE_KEY=sua_chave_service_role_ou_anon_aqui
SUPABASE_BUCKET_COMPROVANTES=comprovantes

# Nome do modelo Gemini para OCR/Visão
GEMINI_MODEL=gemini-3.8-flash
